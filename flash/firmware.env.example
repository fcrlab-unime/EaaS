# Add these entries to flash/.env, then rebuild/reflash through a new job.
INFERENCE_UART_PORT=0
INFERENCE_UART_BAUD=115200
INFERENCE_UART_TX_GPIO=1
INFERENCE_UART_RX_GPIO=3
# FireBeetle ESP32-E V1.0 onboard WS2812 (GPIO5/D8).
LED_RGB_GPIO=5
# Intensity of the active red or green channel (1..255).
LED_BRIGHTNESS=32

# UART bridge on the Docker host (optional; serial port defaults to FLASH_PORT).
# INFERENCE_SERIAL_PORT=/dev/ttyUSB0
UART_API_PORT=8081
